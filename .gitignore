# ==========================================
# 1. Node.js & React / Frontend
# ==========================================
# Ignores node_modules everywhere (root, frontend/node_modules, etc.)
node_modules/
**/node_modules/

# Production build outputs
dist/
build/
out/
.next/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment variables
.env
.env.local
.env.development.local
.env.production.local

# Electron / JS Cache
.eslintcache
.stylelintcache

# ==========================================
# 2. Python & Virtual Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/

# Python Distribution / Packaging
.eggs/
*.egg-info/
*.egg

# ==========================================
# 3. Application Data & Ansible Outputs
# ==========================================
# Telemetry and dynamic CSV inventories (if you don't want local host IPs pushed)
telemetry_log.csv
# Uncomment below if you want hosts_inventory.csv to be local-only:
# hosts_inventory.csv

# Ansible runtime files
inventory/hosts.ini
*.retry

# ==========================================
# 4. OS & IDE Specific Files
# ==========================================
# macOS
.DS_Store
.AppleDouble
.lsflags

# Windows
Thumbs.db
Desktop.ini
ehthumbs.db

# VS Code / JetBrains Editors
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.swp
*.swo